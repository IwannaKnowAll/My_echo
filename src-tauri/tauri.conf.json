{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My Echo",
  "version": "0.2.0",
  "identifier": "com.myecho.app",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../client",
      "wait": false
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../client",
      "wait": true
    },
    "frontendDist": "../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "My Echo",
        "width": 960,
        "height": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}